      </strong>
     </div>
     <div class="card" style="text-align:center;padding:16px;">
      <strong style="font-size:13.5px;">
       Gaby Bella Florist
      </strong>
     </div>
    </div>
   </div>
  </div>
 </section>
 <section class="cta-band">
  <div class="wrap inner">
   <div>
    <h2>
     Mari saling kenal
    </h2>
    <p>
     Siap diskusikan brand, akuisisi, atau kolaborasi ekosistem.
    </p>
   </div>
   <div class="actions">
    <a class="btn btn-lg" href="https://wa.me/62817449760?text=Halo%20Cardi%20Nusantara%21%20Saya%20ingin%20terhubung%20%2F%20konsultasi." rel="noopener" target="_blank">
     WhatsApp
    </a>
   </div>
  </div>
 </section>
</main>

</BaseLayout>
