     </span>
     <span>
      <b>
       500+
      </b>
      leads delivered
     </span>
     <span>
      <b>
       6
      </b>
      ecosystem units
     </span>
    </div>
   </div>
  </div>
 </section>
 <!-- MARQUEE TICKER -->
