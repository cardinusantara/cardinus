---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout 
  title="Blog & Insight — Strategi Brand, Digital & Bisnis Indonesia | Cardi Nusantara"
  description="Artikel, panduan, dan riset pasar mengenai branding, marketing digital, strategi ekspansi pasar, dan kesiapan IPO untuk bisnis di Indonesia."
  activeNav="blog"
>
  <section class="section soft" style="padding: 80px 0 40px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="wrap">
      <div class="section-head center">
        <div class="eyebrow">// Insight &amp; Panduan</div>
        <h1 style="font-size: clamp(32px, 5vw, 54px); margin: 16px 0 20px; line-height: 1.15;">
          Strategi Brand, Pasar, dan Pertumbuhan.
        </h1>
        <p class="lead" style="max-width: 720px; margin: 0 auto;">
          Kumpulan analisis mendalam dari tim praktisi Cardi Nusantara mengenai branding, strategi go-to-market, digital marketing, hingga kesiapan bursa.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid cols-3" style="gap: 24px;">
        {sortedPosts.map((post) => (
          <ArticleCard 
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            cover={post.data.cover}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="cta-sec" style="margin: 60px 0 0;">
    <div class="wrap inner">
      <div class="cta-card" style="text-align: center; max-width: 800px; margin: 0 auto; padding: 60px 24px;">
        <h2>Siap Mengembangkan Brand Anda?</h2>
        <p class="lead" style="margin: 16px auto 28px;">
          Diskusikan target ekspansi dan strategi brand bersama tim ahli Cardi Nusantara.
        </p>
        <a class="btn btn-lg btn-red" href="https://wa.me/62817449760?text=Halo%20Cardi%20Nusantara%21%20Saya%20ingin%20terhubung%20%2F%20konsultasi." rel="noopener" target="_blank">
          Hubungi via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
