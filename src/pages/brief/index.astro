---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kirim Brief Proyek — Cardi Nusantara"
  description="Kirim brief proyek branding, digital, GTM, atau IPO ke Cardi Nusantara. Kami tanggapi dengan solusi dan langkah awal dalam 1 hari kerja."
  activeNav="brief"
>
  <!-- HERO -->
  <section class="hero hero-dark">
    <div class="wrap">
      <div class="hero-copy">
        <span class="eyebrow">Kirim Brief</span>
        <h1>Ceritakan proyekmu dalam 2 menit.</h1>
        <p class="lead">
          Kami telaah kebutuhan bisnis Anda dan balas dengan langkah pertama yang jelas dan terarah — biasanya dalam 1 hari kerja.
        </p>
      </div>
    </div>
  </section>

  <!-- FORM & INFO SPLIT -->
  <section class="sec">
    <div class="wrap">
      <div class="split">
        <!-- FORM -->
        <div>
          <form class="form" id="brief-form">
            <p class="form-intro">Semua kolom bertanda <span style="color:#e53e3e;">*</span> wajib diisi.</p>

            <div class="field">
              <label for="brief-nama">Nama Lengkap <span style="color:#e53e3e;">*</span></label>
              <input id="brief-nama" name="nama" type="text" placeholder="Nama Anda" required />
            </div>

            <div class="field">
              <label for="brief-bisnis">Nama Bisnis &amp; Industri <span style="color:#e53e3e;">*</span></label>
              <input id="brief-bisnis" name="bisnis" type="text" placeholder="Contoh: Kopi Nusantara (F&B / Ritel)" required />
            </div>

            <fieldset class="field">
              <legend>Layanan yang Dibutuhkan</legend>
              <div class="checkgroup">
                <label class="chk">
                  <input type="checkbox" name="layanan" value="Branding" /> Branding
                </label>
                <label class="chk">
                  <input type="checkbox" name="layanan" value="Brand Check Up" /> Brand Check Up
                </label>
                <label class="chk">
                  <input type="checkbox" name="layanan" value="Digital" /> Digital Activation
                </label>
                <label class="chk">
                  <input type="checkbox" name="layanan" value="Go-to-Market" /> Go-to-Market
                </label>
                <label class="chk">
                  <input type="checkbox" name="layanan" value="IPO Partner" /> IPO Partner
                </label>
              </div>
            </fieldset>

            <div class="field">
              <label for="brief-anggaran">Perkiraan Alokasi Anggaran</label>
              <select id="brief-anggaran" name="anggaran">
                <option value="">Pilih rentang anggaran…</option>
                <option value="< Rp 10 jt">&lt; Rp 10 jt</option>
                <option value="Rp 10–25 jt">Rp 10–25 jt</option>
                <option value="Rp 25–50 jt">Rp 25–50 jt</option>
                <option value="Rp 50–100 jt">Rp 50–100 jt</option>
                <option value="> Rp 100 jt">&gt; Rp 100 jt</option>
                <option value="Belum tahu / Konsultasi dulu">Belum tahu / Konsultasi dulu</option>
              </select>
            </div>

            <div class="field">
              <label for="brief-waktu">Target Waktu Mulai</label>
              <select id="brief-waktu" name="waktu">
                <option value="">Pilih waktu mulai…</option>
                <option value="Secepatnya (Minggu ini)">Secepatnya (Minggu ini)</option>
                <option value="Bulan ini">Bulan ini</option>
                <option value="1–3 bulan lagi">1–3 bulan lagi</option>
                <option value="Masih eksplorasi / Perencanaan">Masih eksplorasi / Perencanaan</option>
              </select>
            </div>

            <div class="field">
              <label for="brief-tujuan">Tujuan &amp; Tantangan Utama <span style="color:#e53e3e;">*</span></label>
              <textarea id="brief-tujuan" name="tujuan" rows="4" placeholder="Apa yang ingin dicapai, dan apa hambatan terbesar bisnis Anda saat ini?" required></textarea>
            </div>

            <button class="btn btn-primary btn-block" type="submit" style="margin-top:8px;">
              Kirim via WhatsApp
            </button>

            <p class="form-note">
              🔒 Form ini akan langsung membuka aplikasi WhatsApp Anda dengan format pesan rapi yang terisi otomatis. Data Anda tidak disimpan di server situs.
            </p>
          </form>
        </div>

        <!-- SIDEBAR INFO -->
        <div style="display:flex;flex-direction:column;gap:20px;">
          <article class="card">
            <div class="card-top">
              <span class="tag gold">Transparan</span>
            </div>
            <h3 style="font-size:20px;">Setelah brief dikirim:</h3>
            <ul class="checks" style="font-size:14.5px;line-height:1.6;">
              <li>Tim strategi kami menelaah kebutuhan dalam 1 hari kerja</li>
              <li>Sesi Discovery Session 30–60 menit via Google Meet atau tatap muka</li>
              <li>Pengiriman dokumen proposal ruang lingkup, jadwal kerja &amp; investasi</li>
              <li>Kick-off proyek dimulai setelah kesepakatan dan DP 50%</li>
            </ul>
          </article>

          <article class="card">
            <div class="card-top">
              <span class="tag">Evaluasi Mandiri</span>
            </div>
            <h3 style="font-size:20px;">Mau cek kondisi brand dulu?</h3>
            <p style="font-size:14.5px;color:var(--muted);line-height:1.6;">
              Gunakan kalkulator Brand Check Up interaktif gratis untuk melihat pilar terlemah dari brand Anda dalam waktu kurang dari 3 menit.
            </p>
            <a class="card-link" href="https://cardi.co.id/cek-brand/" target="_blank" rel="noopener">
              Cek Brand Sekarang →
            </a>
          </article>

          <article class="card" style="background:var(--soft);border-color:#CFCABD;">
            <h3 style="font-size:18px;">Lebih suka ngobrol langsung?</h3>
            <p style="font-size:14px;color:var(--ink-2);line-height:1.5;">
              Hubungi representatif tim Cardi Nusantara langsung melalui nomor WhatsApp resmi kami di <strong>0812-8989-5646</strong>.
            </p>
            <a class="btn btn-outline btn-sm" href="https://api.whatsapp.com/send?phone=6281289895646&text=Halo%20Cardi%20Nusantara%2C%20saya%20ingin%20konsultasi%20langsung." target="_blank" rel="noopener" style="margin-top:12px;background:#fff;">
              Chat WhatsApp
            </a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('brief-form') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const WA_NUMBER = '6281289895646';

        const nama = (form.querySelector('#brief-nama') as HTMLInputElement)?.value.trim() || '';
        const bisnis = (form.querySelector('#brief-bisnis') as HTMLInputElement)?.value.trim() || '';
        const anggaran = (form.querySelector('#brief-anggaran') as HTMLSelectElement)?.value || 'Belum ditentukan';
        const waktu = (form.querySelector('#brief-waktu') as HTMLSelectElement)?.value || 'Belum ditentukan';
        const tujuan = (form.querySelector('#brief-tujuan') as HTMLTextAreaElement)?.value.trim() || '';

        const selectedServices: string[] = [];
        form.querySelectorAll<HTMLInputElement>('input[name="layanan"]:checked').forEach(chk => {
          selectedServices.push(chk.value);
        });

        const lines = [
          '*[Brief Proyek — Cardi Nusantara]*',
          '',
          `👤 *Nama:* ${nama}`,
          `🏢 *Bisnis & Industri:* ${bisnis}`,
          `🎯 *Layanan:* ${selectedServices.length > 0 ? selectedServices.join(', ') : 'Belum dipilih'}`,
          `💰 *Perkiraan Anggaran:* ${anggaran}`,
          `⏱️ *Target Mulai:* ${waktu}`,
          '',
          `📝 *Tujuan & Tantangan Utama:*`,
          tujuan,
          '',
          '---',
          'Terkirim via form cardinusantara.com/brief'
        ];

        const fullMessage = lines.join('\n');
        const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(fullMessage)}`;
        window.open(waUrl, '_blank', 'noopener');
      });
    }
  </script>
</BaseLayout>
