   <h2>
    Let's open Indonesia together.
   </h2>
   <p class="lead" style="margin:16px auto 0;">
    Ceritakan brand Anda, kami petakan GTM system dalam satu minggu.
   </p>
   <div class="contact-grid">
    <div class="contact-info">
     <h4>
      Kontak
     </h4>
     <div class="ci-row">
      <span class="k">
       WhatsApp
      </span>
      <span class="v">
       +62 817-449-760
      </span>
     </div>
     <div class="ci-row">
      <span class="k">
       Lokasi
      </span>
      <span class="v">
       Jakarta, Indonesia
      </span>
     </div>
     <div class="ci-row">
      <span class="k">
       Jam Operasional
      </span>
      <span class="v">
       Senin–Jumat, 09.00–18.00 WIB
      </span>
     </div>
     <a class="btn btn-wa" href="https://wa.me/62817449760?text=Halo%20Cardi%20Nusantara%21%20Saya%20ingin%20terhubung%20%2F%20konsultasi." rel="noopener" style="margin-top:6px;width:100%;" target="_blank">
      Chat via WhatsApp →
     </a>
    </div>
    <form action="https://wa.me/62817449760?text=Halo%20Cardi%20Nusantara%21%20Saya%20ingin%20terhubung%20%2F%20konsultasi." class="contact-form" method="get" rel="noopener" target="_blank">
     <div class="form-row">
      <div>
       <label>
        Nama
       </label>
       <input name="nama" required="" type="text"/>
      </div>
      <div>
       <label>
        Nama Brand / Perusahaan
       </label>
       <input name="brand" required="" type="text"/>
      </div>
     </div>
     <div class="form-row">
      <div>
       <label>
        Email
       </label>
       <input name="email" required="" type="email"/>
      </div>
      <div>
       <label>
        WhatsApp
       </label>
       <input name="wa" type="tel"/>
      </div>
     </div>
     <label>
      Jenis Brand
     </label>
     <div class="radio-group">
      <label class="radio-pill">
       <input checked="" name="jenis" type="radio" value="Brand Lokal"/>
       Brand Lokal
      </label>
      <label class="radio-pill">
       <input name="jenis" type="radio" value="Brand Luar Negeri"/>
       Brand Luar Negeri
      </label>
     </div>
     <label>
      Ceritakan Brand Anda
     </label>
     <textarea name="pesan" placeholder="Produk, target pasar, dan tantangan GTM saat ini..."></textarea>
     <div style="margin-top:18px;">
      <button class="btn btn-red btn-lg" style="border:none;cursor:pointer;" type="submit">
       Start Your GTM →
      </button>
     </div>
    </form>
   </div>
   <div class="footer-caption" style="margin-top:32px;font-size:13.5px;color:var(--muted);">
    Cardi Nusantara Group · Jakarta ·
    <b style="color:#E8492A;">
     cardinusantara.com
    </b>
    · @cardinusantara
   </div>
  </div>
 </section>
</main>


</BaseLayout>

<script>
  const contactForm = document.querySelector('#contact form');
  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const nama = (contactForm.querySelector('input[name="nama"]') as HTMLInputElement)?.value || '';
      const brand = (contactForm.querySelector('input[name="brand"]') as HTMLInputElement)?.value || '';
      const email = (contactForm.querySelector('input[name="email"]') as HTMLInputElement)?.value || '';
      const wa = (contactForm.querySelector('input[name="wa"]') as HTMLInputElement)?.value || '';
      const jenis = (contactForm.querySelector('input[name="jenis"]:checked') as HTMLInputElement)?.value || 'Brand Lokal';
      const pesan = (contactForm.querySelector('textarea[name="pesan"]') as HTMLTextAreaElement)?.value || '';

      const lines = [
        '*[Inquiry GTM: Cardi Nusantara]*',
        '',
        `👤 *Nama:* ${nama}`,
        `🏢 *Brand/Perusahaan:* ${brand}`,
        `📧 *Email:* ${email}`,
        `📱 *WhatsApp:* ${wa}`,
        `🎯 *Jenis Brand:* ${jenis}`,
        '',
        `💬 *Pesan / Target:*`,
        pesan,
        '',
        '---',
        'Terkirim via form cardinusantara.com'
      ];

      const waUrl = `https://wa.me/62817449760?text=${encodeURIComponent(lines.join('\n'))}`;
      window.open(waUrl, '_blank', 'noopener');
    });
  }
</script>

<script>
  // Interactive Client Tabs Filter
  const clientTabs = document.querySelectorAll('.client-tab');
  const clientCards = document.querySelectorAll('.client-card');

  clientTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      clientTabs.forEach((t) => t.classList.remove('is-active'));
      tab.classList.add('is-active');

      const targetCat = tab.getAttribute('data-cat');
      clientCards.forEach((card) => {
        const cardCat = card.getAttribute('data-cat');
        if (targetCat === 'all' || cardCat === targetCat) {
          (card as HTMLElement).style.display = 'flex';
          (card as HTMLElement).style.opacity = '1';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
