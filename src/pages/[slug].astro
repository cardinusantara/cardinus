---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(post.data.pubDate);

const canonicalUrl = `https://cardinusantara.com/${post.slug}`;
const shareUrl = encodeURIComponent(canonicalUrl);
const shareTitle = encodeURIComponent(post.data.title);

// JSON-LD Structured Data
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': post.data.title,
  'description': post.data.description,
  'image': post.data.cover || 'https://cardinusantara.com/logos/nusantara/logo-nusantara-dark.png',
  'datePublished': post.data.pubDate.toISOString(),
  'author': {
    '@type': 'Organization',
    'name': 'Cardi Nusantara',
    'url': 'https://cardinusantara.com'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'Cardi Nusantara',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://cardinusantara.com/logos/nusantara/icon-nusantara.png'
    }
  },
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': canonicalUrl
  }
};
---

<BaseLayout
  title={`${post.data.title} - Cardi Nusantara`}
  description={post.data.description}
  ogImage={post.data.cover}
  canonical={canonicalUrl}
  activeNav="blog"
  articleJsonLd={jsonLd}
>
  <article class="article-page">
    <div class="wrap article-wrap">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Beranda</a>
        <span class="bc-sep">/</span>
        <a href="/blog">Blog</a>
        <span class="bc-sep">/</span>
        <span class="bc-current" aria-current="page">{post.data.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="article-header">
        <span class="eyebrow">// Insight &amp; Panduan</span>
        <h1 class="article-main-title">{post.data.title}</h1>
        
        <div class="article-byline">
          <span class="byline-author">Oleh <b>{post.data.author || 'Cardi Nusantara'}</b></span>
          <span class="byline-sep">·</span>
          <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
        </div>
      </header>

      <!-- Featured Image Banner -->
      {post.data.cover && (
        <div class="article-featured-media">
          <img 
            src={post.data.cover} 
            alt={post.data.title} 
            class="featured-img" 
            loading="lazy"
          />
        </div>
      )}

      <!-- Article Body (Rendered HTML Content) -->
      <div class="prose article-body">
        <Content />
      </div>

      <!-- Share & Discussion Band -->
      <div class="article-share-strip">
        <span class="share-label">Bagikan artikel:</span>
        <div class="share-links">
          <a 
            href={`https://wa.me/?text=${shareTitle}%20${shareUrl}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="share-btn share-wa"
          >
            WhatsApp
          </a>
          <a 
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="share-btn share-li"
          >
            LinkedIn
          </a>
          <a 
            href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="share-btn share-tw"
          >
            Twitter / X
          </a>
        </div>
      </div>

      <!-- Bottom Consultation Box -->
      <div class="article-cta-box">
        <div class="cta-box-copy">
          <h3>Ingin Menerapkan Strategi Ini Pada Bisnis Anda?</h3>
          <p>
            Konsultasikan rencana branding, ekspansi pasar, atau kesiapan IPO Anda langsung dengan tim ahli Cardi Nusantara.
          </p>
        </div>
        <div class="cta-box-actions">
          <a class="btn btn-red" href="https://wa.me/62817449760?text=Halo%20Cardi%20Nusantara%21%20Saya%20ingin%20konsultasi%20strategi." target="_blank" rel="noopener">
            Konsultasi via WhatsApp
          </a>
          <a class="btn btn-ghost" href="/#contact">
            Kirim Inquiry GTM
          </a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding: 60px 0 100px;
    background: #000000;
    color: rgba(255, 255, 255, 0.85);
  }

  .article-wrap {
    max-width: 820px;
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: color 0.15s;
  }

  .breadcrumb a:hover {
    color: #ffffff;
  }

  .bc-sep {
    opacity: 0.4;
  }

  .bc-current {
    color: #ffffff;
    font-weight: 600;
    max-width: 320px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Header */
  .article-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .article-main-title {
    font-size: clamp(28px, 4.5vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
  }

  .byline-author b {
    color: #ffffff;
  }

  .byline-sep {
    opacity: 0.4;
  }

  /* Featured Image */
  .article-featured-media {
    margin-bottom: 36px;
    border-radius: 12px;
    overflow: hidden;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .featured-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* Body Content Styles */
  .article-body {
    font-size: 17.5px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.85);
  }

  .article-body :global(h2) {
    font-size: 26px;
    margin-top: 40px;
    margin-bottom: 16px;
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 8px;
  }

  .article-body :global(h3) {
    font-size: 20px;
    margin-top: 32px;
    margin-bottom: 12px;
    color: #ffffff;
  }

  .article-body :global(p) {
    margin-bottom: 20px;
    line-height: 1.75;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 24px;
    margin-bottom: 24px;
  }

  .article-body :global(li) {
    margin-bottom: 8px;
  }

  .article-body :global(strong) {
    color: #ffffff;
  }

  .article-body :global(a) {
    color: #ff9070;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-body :global(a:hover) {
    color: #ffffff;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid #ff9070;
    padding: 16px 20px;
    background: #111111;
    border-radius: 0 10px 10px 0;
    margin: 24px 0;
    font-style: italic;
    color: #ffffff;
  }

  .article-body :global(nav) {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 20px 24px;
    margin: 28px 0;
  }

  .article-body :global(nav h2) {
    font-size: 15px;
    margin: 0 0 12px;
    border-bottom: none;
    padding: 0;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.6);
  }

  .article-body :global(nav ul) {
    padding-left: 20px;
    margin: 0;
  }

  .article-body :global(nav li) {
    margin-bottom: 6px;
  }

  /* Share Strip */
  .article-share-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
    margin: 48px 0 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
    gap: 16px;
  }

  .share-label {
    font-weight: 700;
    font-size: 14.5px;
    color: #ffffff;
  }

  .share-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .share-btn {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s, opacity 0.15s;
    display: inline-flex;
    align-items: center;
  }

  .share-btn:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .share-wa {
    background: #0B7A4B;
    color: #ffffff;
  }

  .share-li {
    background: #0A66C2;
    color: #ffffff;
  }

  .share-tw {
    background: #111111;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  /* Bottom Consultation Box */
  .article-cta-box {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .article-cta-box h3 {
    font-size: 22px;
    color: #ffffff;
    margin: 0;
  }

  .article-cta-box p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 15.5px;
    line-height: 1.6;
    margin: 0;
  }

  .cta-box-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 6px;
  }

  @media (max-width: 640px) {
    .article-page {
      padding: 32px 0 60px;
    }
    .article-cta-box {
      padding: 24px;
    }
    .cta-box-actions {
      flex-direction: column;
    }
    .cta-box-actions a {
      width: 100%;
      text-align: center;
    }
  }
</style>
