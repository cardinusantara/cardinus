---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  activeNav?: string;
  ogImage?: string;
  articleJsonLd?: object;
  lang?: 'id' | 'en' | 'zh';
}

const {
  title = "Cardi Nusantara | Perusahaan Go-To-Market - Bangun Brand - Cardi GTM Matrix™",
  description = "Indonesia's Go-To-Market Partner: We generate leads, we build brands, we close markets. Full closed-loop GTM system dari lead pertama sampai penjualan pertama.",
  canonical,
  activeNav = 'home',
  ogImage = "/logos/nusantara/logo-nusantara-light.png",
  articleJsonLd,
  lang = (Astro.url.pathname.startsWith('/en') ? 'en' : Astro.url.pathname.startsWith('/zh') ? 'zh' : 'id') as 'id' | 'en' | 'zh',
} = Astro.props;

const siteUrl = "https://cardinusantara.com";
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const socialImage = ogImage.startsWith("http") ? ogImage : new URL(ogImage, siteUrl).href;

const waFloatUrl = {
  id: "https://wa.me/62817449760?text=Halo%20Cardi%20Nusantara%21%20Saya%20ingin%20terhubung%20%2F%20konsultasi.",
  en: "https://wa.me/62817449760?text=Hello%20Cardi%20Nusantara!%20I%20would%20like%20to%20inquire%20about%20GTM%20partnership.",
  zh: "https://wa.me/62817449760?text=%E4%BD%A0%E5%A5%BD%EF%BC%8CCardi%20Nusantara%EF%BC%81%E6%88%91%E6%83%B3%E5%92%A8%E8%AF%A2%E5%8D%B0%E5%B0%BC%E5%B8%82%E5%9C%BA%E6%8B%93%E5%B1%95%E5%90%88%E4%BD%9C%E3%80%82"
}[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- International SEO hreflang tags -->
    <link rel="alternate" hreflang="id" href="https://cardinusantara.com/" />
    <link rel="alternate" hreflang="en" href="https://cardinusantara.com/en/" />
    <link rel="alternate" hreflang="zh" href="https://cardinusantara.com/zh/" />
    <link rel="alternate" hreflang="x-default" href="https://cardinusantara.com/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Cardi Nusantara" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Typography (Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=IBM+Plex+Mono:wght@500;600&display=swap" 
      rel="stylesheet" 
    />

    {articleJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}
  </head>
  <body>
    <!-- Site Header Navigation (Two-Tier: EcoNav + Navbar) -->
    <Navbar activeNav={activeNav} currentLang={lang} />

    <!-- Main Page Content -->
    <main id="content">
      <slot />
    </main>

    <!-- Site Footer -->
    <Footer currentLang={lang} />

    <!-- Floating WhatsApp CTA -->
    <a 
      aria-label="WhatsApp" 
      class="wa-float" 
      href={waFloatUrl} 
      rel="noopener" 
      target="_blank"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
      </svg>
    </a>

    <!-- Interactive Client Script -->
    <script src="/assets/js/main.js" defer></script>
  </body>
</html>
