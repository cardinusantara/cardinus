---
interface Props {
  activeNav?: string;
  currentLang?: 'id' | 'en' | 'zh';
}

const { activeNav = 'home', currentLang = 'id' } = Astro.props;

const navText = {
  id: {
    layanan: "Layanan",
    home: "Home",
    about: "About",
    blog: "Blog",
    contact: "Hubungi Kami",
    waUrl: "https://wa.me/62817449760?text=Halo%20Cardi%20Nusantara%21%20Saya%20ingin%20terhubung%20%2F%20konsultasi.",
    brandDesc: "Brand Development & Visual Identity System",
    digitalDesc: "Scale-up performa iklan & omzet bisnis",
  },
  en: {
    layanan: "Services",
    home: "Home",
    about: "About",
    blog: "Blog",
    contact: "Contact Us",
    waUrl: "https://wa.me/62817449760?text=Hello%20Cardi%20Nusantara!%20I%20would%20like%20to%20inquire%20about%20GTM%20partnership.",
    brandDesc: "Brand Development & Visual Identity System",
    digitalDesc: "Scale-up ad performance & revenue growth",
  },
  zh: {
    layanan: "业务服务",
    home: "首页",
    about: "关于我们",
    blog: "博客",
    contact: "联系我们",
    waUrl: "https://wa.me/62817449760?text=%E4%BD%A0%E5%A5%BD%EF%BC%8CCardi%20Nusantara%EF%BC%81%E6%88%91%E6%83%B3%E5%92%A8%E8%AF%A2%E5%8D%B0%E5%B0%BC%E5%B8%82%E5%9C%BA%E6%8B%93%E5%B1%95%E5%90%88%E4%BD%9C%E3%80%82",
    brandDesc: "品牌开发与视觉识别系统",
    digitalDesc: "效果营销与营收规模化增长",
  }
}[currentLang];

const homeHref = currentLang === 'id' ? '/' : `/${currentLang}`;
---

<header class="site-header" id="siteHeader">
  <!-- Primary Navigation -->
  <div class="wrap nav-in">
    <!-- Brand Logo with New Official Cardi Nusantara Logo -->
    <a class="brand" href={homeHref} aria-label="Cardi Nusantara">
      <img 
        src="/logos/nusantara/logo-nusantara-dark.png" 
        alt="Cardi Nusantara" 
        height="44" 
        width="190"
        style="height:44px;width:auto;display:block;" 
      />
    </a>

    <!-- Desktop Navigation Menu -->
    <nav class="nav-menu" aria-label="Primary">
      <a class="btn-back-cardi" href="https://cardi.co.id" title="Kembali ke portal utama cardi.co.id">
        ← cardi.co.id
      </a>

      <!-- Dropdown Layanan -->
      <div class="menu-item has-dropdown">
        <a class="dropdown-trigger" href={`${homeHref}#layanan`}>
          <span>{navText.layanan}</span>
          <svg class="car" fill="none" height="12" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="12">
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </a>
        <div class="dark-dropdown wide">
          <!-- Item 1: Cardi Branding -->
          <a class="drop-link" href="https://branding.cardinusantara.com/" rel="noopener" target="_blank">
            <span class="dLock">
              <span class="dIcon dIcon-orange">
                <svg fill="none" height="20" viewBox="0 0 120 120" width="20">
                  <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#fb3202" transform="translate(60 60) rotate(0) scale(1.35) translate(-60 -38)"></path>
                </svg>
              </span>
              <span class="dTx">
                <small>cardi</small>
                <b>Branding</b>
              </span>
            </span>
            <span class="dDesc">{navText.brandDesc}</span>
          </a>
          <!-- Item 2: Cardi Digital -->
          <a class="drop-link" href="https://digital.cardinusantara.com/" rel="noopener" target="_blank">
            <span class="dLock">
              <span class="dIcon dIcon-red">
                <svg fill="none" height="20" viewBox="0 0 120 120" width="20">
                  <path d="M60 62 C46 46 47 22 60 14 C73 22 74 46 60 62 Z" fill="#ef4444" transform="translate(60 52) rotate(0) scale(1.3) translate(-60 -38)"></path>
                  <circle cx="60" cy="102" fill="#ef4444" r="8"></circle>
                </svg>
              </span>
              <span class="dTx">
                <small>cardi</small>
                <b>Digital Marketing</b>
              </span>
            </span>
            <span class="dDesc">{navText.digitalDesc}</span>
          </a>
        </div>
      </div>

      <a class={`menu-item ${activeNav === 'home' ? 'is-active' : ''}`} href={homeHref}>{navText.home}</a>
      <a class={`menu-item ${activeNav === 'about' ? 'is-active' : ''}`} href="/about">{navText.about}</a>
      <a class={`menu-item ${activeNav === 'blog' ? 'is-active' : ''}`} href="/blog">{navText.blog}</a>
    </nav>

    <!-- Nav Right Controls -->
    <div class="nav-right">
      <div class="lang-switch">
        <a class={`lang-item ${currentLang === 'id' ? 'is-active' : ''}`} href="/" hreflang="id-ID">ID</a>
        <a class={`lang-item ${currentLang === 'en' ? 'is-active' : ''}`} href="/en/" hreflang="en-US">EN</a>
        <a class={`lang-item ${currentLang === 'zh' ? 'is-active' : ''}`} href="/zh/" hreflang="zh-CN">ZH</a>
      </div>

      <a class="btn btn-accent" href={navText.waUrl} rel="noopener" target="_blank">
        {navText.contact}
      </a>

      <!-- Hamburger Button for Mobile -->
      <button aria-controls="mobileDrawer" aria-expanded="false" aria-label="Menu" class="nav-toggle" id="navToggle" type="button">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-drawer" id="mobileDrawer">
  <div style="padding:12px 16px 4px;">
    <a class="btn-back-cardi" href="https://cardi.co.id" style="display:inline-flex;width:100%;justify-content:center;">
      ← cardi.co.id
    </a>
  </div>

  <div class="mobile-menu-group" id="mobileLayananGroup">
    <button class="mobile-menu-trigger" id="mobileLayananBtn" type="button">
      <span>{navText.layanan}</span>
      <svg class="chevron" fill="none" height="16" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="16">
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </button>
    <div class="mobile-accordion-body" id="mobileAccordionBody">
      <a class="mobile-sub-link" href="https://branding.cardinusantara.com/" rel="noopener" target="_blank">
        <span class="dLock">
          <b>Cardi Branding</b>
        </span>
        <small>{navText.brandDesc}</small>
      </a>
      <a class="mobile-sub-link" href="https://digital.cardinusantara.com/" rel="noopener" target="_blank">
        <span class="dLock">
          <b>Cardi Digital</b>
        </span>
        <small>{navText.digitalDesc}</small>
      </a>
    </div>
  </div>

  <a class={`menu-item ${activeNav === 'home' ? 'is-active' : ''}`} href={homeHref}>{navText.home}</a>
  <a class={`menu-item ${activeNav === 'about' ? 'is-active' : ''}`} href="/about">{navText.about}</a>
  <a class={`menu-item ${activeNav === 'blog' ? 'is-active' : ''}`} href="/blog">{navText.blog}</a>

  <div class="mobile-lang-row" style="display:flex;gap:10px;padding:14px 16px;border-top:1px solid rgba(255,255,255,0.1);margin-top:12px;">
    <a class={`lang-item ${currentLang === 'id' ? 'is-active' : ''}`} href="/" style="min-height:44px;min-width:48px;display:inline-flex;align-items:center;justify-content:center;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;color:white;border:1px solid rgba(255,255,255,0.25);">ID</a>
    <a class={`lang-item ${currentLang === 'en' ? 'is-active' : ''}`} href="/en/" style="min-height:44px;min-width:48px;display:inline-flex;align-items:center;justify-content:center;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;color:white;border:1px solid rgba(255,255,255,0.25);">EN</a>
    <a class={`lang-item ${currentLang === 'zh' ? 'is-active' : ''}`} href="/zh/" style="min-height:44px;min-width:48px;display:inline-flex;align-items:center;justify-content:center;padding:8px 14px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;color:white;border:1px solid rgba(255,255,255,0.25);">ZH</a>
  </div>

  <div class="mobile-cta">
    <a class="btn btn-wa" href={navText.waUrl} rel="noopener" target="_blank">
      WhatsApp
    </a>
  </div>
</div>

<style>
  .btn-back-cardi {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: #475569;
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-back-cardi:hover {
    color: #0A1633;
    background: #E2E8F0;
    border-color: #CBD5E1;
  }
</style>
