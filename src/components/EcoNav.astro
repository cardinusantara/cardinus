---
// Cardi Ecosystem top bar
---
<div class="eco">
  <div class="wrap eco-in">
    <span class="eco-label">Bagian dari ekosistem Cardi</span>
    <nav aria-label="Ekosistem Cardi">
      <a href="https://cardi.co.id/">Cardi</a>
      <span class="eco-sep">·</span>
      <a href="/" class="active" aria-current="page">Cardi Nusantara</a>
      <span class="eco-sep">·</span>
      <a href="https://aiagent.cardi.co.id/" target="_blank" rel="noopener">Cardi Agent</a>
      <span class="eco-sep">·</span>
      <a href="https://cardi.co.id/toko/">Toko Cardi</a>
    </nav>
  </div>
</div>

<style>
  .eco {
    background: #0A1633;
    color: #94A3B8;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    padding: 7px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .eco-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .eco-label {
    color: #64748B;
    font-size: 11px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .eco nav {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .eco a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.15s ease;
    font-size: 11.5px;
  }
  .eco a:hover,
  .eco a.active {
    color: #F4F5F0;
    font-weight: 600;
  }
  .eco-sep {
    color: rgba(255, 255, 255, 0.2);
    user-select: none;
  }
  @media (max-width: 640px) {
    .eco-label {
      display: none;
    }
    .eco-in {
      justify-content: center;
    }
    .eco nav {
      gap: 8px;
      font-size: 10.5px;
    }
    .eco a {
      font-size: 10.5px;
    }
  }
</style>
