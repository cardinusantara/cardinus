---
// Cardi Ecosystem top micro-bar (Tier 1 of Two-Tier Unified Header)
interface Props {
  currentLang?: 'id' | 'en' | 'zh';
}

const { currentLang = 'id' } = Astro.props;

const label = {
  id: "Bagian dari ekosistem Cardi",
  en: "Part of the Cardi Ecosystem",
  zh: "Cardi 商业生态成员",
}[currentLang];

const homeHref = currentLang === 'id' ? '/' : `/${currentLang}/`;
---
<div class="eco">
  <div class="wrap eco-in">
    <span class="eco-label">{label}</span>
    <nav aria-label="Ekosistem Cardi">
      <a href="https://cardi.co.id/">Cardi</a>
      <span class="eco-sep">·</span>
      <a href={homeHref} class="active" aria-current="page">Cardi Nusantara</a>
      <span class="eco-sep">·</span>
      <a href="https://aiagent.cardi.co.id/" target="_blank" rel="noopener">Cardi Agent</a>
      <span class="eco-sep">·</span>
      <a href="https://nfc.cardi.co.id/" target="_blank" rel="noopener">Cardi NFC</a>
      <span class="eco-sep">·</span>
      <a href="https://cardi.co.id/toko/">Toko Cardi</a>
    </nav>
  </div>
</div>

<style>
  .eco {
    background: #F4F3EE;
    color: #475569;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 500;
    padding: 7px 0;
    border-bottom: 1px solid #E6E4DE;
    width: 100%;
    flex-shrink: 0;
  }
  .eco-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .eco-label {
    color: #64748B;
    font-size: 11px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .eco nav {
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
  }
  .eco a {
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease;
    font-size: 11.5px;
  }
  .eco a:hover {
    color: #0A1633;
  }
  .eco a.active {
    color: #0A1633;
    font-weight: 700;
  }
  .eco-sep {
    color: #CBD5E1;
    user-select: none;
  }
  @media (max-width: 640px) {
    .eco {
      padding: 6px 0;
    }
    .eco-label {
      display: none;
    }
    .eco-in {
      justify-content: center;
    }
    .eco nav {
      gap: 8px;
      font-size: 10.5px;
    }
    .eco a {
      font-size: 10.5px;
    }
  }
</style>
