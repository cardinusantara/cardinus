---
interface Props {
  title: string;
  description?: string;
  pubDate?: Date | string;
  slug: string;
  cover?: string;
}

const { title, description, pubDate, slug, cover } = Astro.props;

const dateObj = pubDate instanceof Date ? pubDate : (pubDate ? new Date(pubDate) : new Date());

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(dateObj);
---

<article class="article-card">
  {cover && (
    <a href={`/${slug}`} class="article-cover-link" tabindex="-1" aria-hidden="true">
      <img 
        src={cover} 
        alt={title} 
        class="article-cover" 
        loading="lazy" 
        onerror="this.style.display='none'"
      />
    </a>
  )}
  <div class="article-content">
    <div class="article-meta">
      <time datetime={dateObj.toISOString()}>{formattedDate}</time>
      <span class="meta-dot">·</span>
      <span>Cardi Nusantara</span>
    </div>
    <h3 class="article-title">
      <a href={`/${slug}`}>{title}</a>
    </h3>
    {description && <p class="article-desc">{description}</p>}
    <a href={`/${slug}`} class="article-readmore">
      Baca artikel &rarr;
    </a>
  </div>
</article>

<style>
  .article-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    border-color: #CFCABD;
    box-shadow: 0 12px 28px -10px rgba(10, 22, 51, 0.1);
  }

  .article-cover-link {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--soft);
  }

  .article-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .article-card:hover .article-cover {
    transform: scale(1.03);
  }

  .article-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--muted);
    font-family: var(--mono);
    font-weight: 500;
  }

  .meta-dot {
    opacity: 0.5;
  }

  .article-title {
    font-size: 19px;
    line-height: 1.3;
    font-weight: 800;
    margin: 0;
  }

  .article-title a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .article-title a:hover {
    color: var(--gold-ink);
  }

  .article-desc {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-readmore {
    margin-top: auto;
    padding-top: 14px;
    font-size: 14px;
    font-weight: 700;
    color: var(--gold-ink);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .article-readmore:hover {
    text-decoration: underline;
  }
</style>
